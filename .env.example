# ===================================================
# RT-FinSmart PRO - Konfigurasi Payment Gateway Pakasir
# Kredensial dapat diperoleh dari Dashboard: https://app.pakasir.com
# ===================================================

# 1. API Key Resmi dari Detail Proyek Pakasir
PAKASIR_API_KEY=your_api_key_here

# 2. Slug Proyek (Contoh: "rt001-grahaasri" atau nama slug unik proyek Anda di Pakasir)
PAKASIR_PROJECT_SLUG=your_project_slug_here

# 3. URL Callback / Webhook yang didaftarkan di dashboard Pakasir:
# https://DOMAIN_ANDA.vercel.app/api/pakasir/webhook
