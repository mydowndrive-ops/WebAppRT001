{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/webhook/pakasir",
      "destination": "/api/webhook/pakasir"
    },
    {
      "source": "/api/pakasir/:path*",
      "destination": "/api/pakasir/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
